{
  "manifest_version": 3,
  "name": "Nova",
  "version": "1.0",
  "description": "Lets your local Nova assistant see and control your tabs. Talks only to Nova on this laptop (127.0.0.1).",
  "permissions": ["tabs", "scripting", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Nova", "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" }
}
